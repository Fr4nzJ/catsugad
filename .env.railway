# CatSU GAD System - Railway.com Environment Template
# Copy these values and add them to your Railway project environment variables

# ============================================
# Core Laravel Configuration
# ============================================
APP_NAME="CatSU_GAD_System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your_generated_key_here
APP_URL=https://your-app-name.railway.app
APP_LOCALE=en
APP_TIMEZONE=Asia/Manila

# ============================================
# Database Configuration (MySQL)
# ============================================
# These use Railway's MySQL plugin variables
DB_CONNECTION=mysql
DB_HOST=${{ Mysql.PRIVATE_URL }}
DB_PORT=3306
DB_DATABASE=${{ Mysql.DATABASE }}
DB_USERNAME=${{ Mysql.USERNAME }}
DB_PASSWORD=${{ Mysql.PASSWORD }}

# ============================================
# Session & Cache Configuration
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
CACHE_PREFIX=

# ============================================
# Queue & Broadcast Configuration
# ============================================
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ============================================
# File Storage Configuration
# ============================================
# Option 1: Local storage (may be lost on restart)
FILESYSTEM_DISK=local

# Option 2: AWS S3 (recommended for production)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your_bucket_name
# AWS_URL=https://your_bucket_name.s3.amazonaws.com
# AWS_ENDPOINT=

# ============================================
# Email Configuration
# ============================================
# Using Mailtrap for development/testing
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@catsugad.app
MAIL_FROM_NAME="CatSU GAD System"

# ============================================
# Third-party API Keys
# ============================================
# Anthropic Claude API for AI features
ANTHROPIC_API_KEY=your_anthropic_api_key

# ============================================
# Logging Configuration
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================
# Redis Configuration (optional)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# Notes
# ============================================
# 1. Generate APP_KEY: php artisan key:generate --show
# 2. Use ${{ Mysql.* }} variables for Railway MySQL plugin
# 3. For AWS S3, create IAM user with S3 permissions
# 4. Update APP_URL to your Railway deployment domain
# 5. Keep sensitive keys secure - never commit to repository
